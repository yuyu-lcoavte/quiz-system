{
  "name": "quiz-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace @quiz/web",
    "dev:server": "npm run dev --workspace @quiz/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
