@startuml
left to right direction
actor Teacher
actor Student
package "Single Web Application" {
  component "React + TypeScript + Vite" as Web
  component "React Router + Shared Layout" as Router
  component "Teacher Routes (Foundation placeholder)" as TeacherUI
  component "Student Routes (Foundation placeholder)" as StudentUI
  component "HTTP Client" as HttpClient
  component "Socket.IO Client" as SocketClient
}
package "Shared Server" {
  component "Express API" as Express
  component "API Routers + Validation" as Api
  component "ActorContext Middleware" as AuthBoundary
  component "Session / State Services" as Services
  component "Socket.IO Gateway (Session Rooms)" as Gateway
  component "Repositories + Migrations" as Persistence
}
package "Shared Contracts" {
  component "TypeScript DTOs (Errors + Events)" as Contracts
}
database "SQLite" as DB
Teacher --> Web
Student --> Web
Web --> Router
Router --> TeacherUI
Router --> StudentUI
TeacherUI --> HttpClient
StudentUI --> HttpClient
TeacherUI --> SocketClient
StudentUI --> SocketClient
HttpClient --> Express : /api/v1
SocketClient --> Gateway : session watch/state
Express --> Api
Api --> AuthBoundary
AuthBoundary --> Services
Services --> Persistence
Gateway --> AuthBoundary
Gateway --> Services : snapshot / state version
Persistence --> DB
Web ..> Contracts : shared types
Express ..> Contracts : shared types
Gateway ..> Contracts : event types
note bottom of TeacherUI
Authentication, Excel, activity controls
and results belong to Teacher Feature.
end note
note bottom of StudentUI
Enrollment, team membership, editing,
submission and results belong to Student Feature.
end note
@enduml
