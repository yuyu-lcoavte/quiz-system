@startuml
title Teacher Feature — Class Diagram (implementation, verified 2026-11-23)
top to bottom direction
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 60
skinparam packageStyle rectangle

package "Auth" {
  class TeacherConfig {
    passwordHash
    sessionSecret
    allowedOrigins
    serviceAccountKeyFile
  }
  class TeacherAuthController <<api>> {
    login(password)
    logout()
    me() : csrfToken, serviceAccountEmail
  }
  class "password-hash" as PasswordHash <<module>> {
    hashPassword(password)
    verifyPassword(password, encoded)
  }
  class LoginRateLimiter {
    5 failures / 15 min / address
    50 failures / 15 min total
  }
  class TeacherLoginSessionService {
    create() : cookie id.HMAC
    verify(cookie)
    revoke(login)
  }
  class TeacherCsrfService {
    issue(loginDigest)
    verify(token, loginDigest)
  }
  class "teacher-actor-factory" as ActorFactory <<module>> {
    createTeacherActorContext(sessionId)
  }
  class TeacherSocketIdentity {
    resolveSocketActorContext(socket)
    authorizeWatch(actor, sessionId)
  }
}

package "Activity and rounds" {
  class ActivityService {
    create(teamCount)
    list()
    detail(sessionId)
  }
  class TargetCatalog {
    targets(sessionId)
    find(sessionId, target)
    next(sessionId)
  }
  class RoundControlService {
    select(sessionId, target, version)
    next(sessionId, version)
    start(sessionId, version)
    end(sessionId, version, actor)
  }
  class TeacherResultProjection {
    monitor(sessionId)
    results(sessionId, roundId?)
    rounds(sessionId)
  }
}

package "Guided Notes" {
  class "sheet-url" as SheetUrl <<module>> {
    parseSheetUrl(url) : SheetRef
  }
  class "parser" as Parser <<module>> {
    parseGuidedNotes(grid) : ParseResult
    blank: cellA1 (fill cell or marker cell), labelCellA1
  }
  class GuidedNotesImportService {
    preview(url)
    confirm(sessionId, url, digest)
  }
  class "cell-composer" as CellComposer <<module>> {
    composeCell(original, answers)
  }
  class WriteBackService {
    preview(sessionId)
    confirm(sessionId, digest)
  }
  interface SheetsGateway {
    readSheet(ref)
    readCells(ref, cells)
    writeCells(ref, updates)
    serviceAccountEmail()
  }
  class GoogleSheetsGateway {
    googleapis, loaded on first call
  }
}

package "tests/helpers (not production)" {
  class FakeSheetsGateway <<test>> {
    in-memory sheets
    recorded writes
    injectable failures
  }
}

package "Export" {
  class ActivityRecordService {
    rows(sessionId)
    csv(sessionId)
  }
  class "csv-writer" as CsvWriter <<module>> {
    writeCsv(header, rows)
    formatTaipeiTime(iso)
  }
}

package "Teacher persistence (006)" {
  class TeacherLoginSessionRepository
  class TeacherSheetSourceRepository
  class TeacherBlankCellRepository {
    cellA1 (fill cell or marker cell)
    originalContent
    marker
    lastWrittenContent
  }
}

package "Foundation / Student (existing)" {
  class SessionLifecycleService <<Foundation>> {
    selectTarget()
    startRound()
  }
  class "Foundation tables / repositories" as FoundationRepositories <<Foundation>>
  class ActorContext <<Foundation>>
  class StudentTrustedEndCoordinator <<Student>> {
    endRound(input, actor)
  }
}

TeacherAuthController --> PasswordHash
TeacherAuthController --> LoginRateLimiter
TeacherAuthController --> TeacherLoginSessionService
TeacherAuthController --> TeacherCsrfService
TeacherLoginSessionService --> TeacherLoginSessionRepository
TeacherSocketIdentity --> TeacherLoginSessionService : verify(cookie)
ActorFactory ..> ActorContext : creates
TeacherSocketIdentity ..> ActorContext : creates

ActivityService --> FoundationRepositories
ActivityService --> TargetCatalog
TargetCatalog --> FoundationRepositories
RoundControlService --> TargetCatalog
RoundControlService --> SessionLifecycleService
RoundControlService --> StudentTrustedEndCoordinator
TeacherResultProjection --> FoundationRepositories

GuidedNotesImportService --> SheetUrl
GuidedNotesImportService --> Parser
GuidedNotesImportService --> SheetsGateway
GuidedNotesImportService --> FoundationRepositories
GuidedNotesImportService --> TeacherSheetSourceRepository
GuidedNotesImportService --> TeacherBlankCellRepository
WriteBackService --> CellComposer
WriteBackService --> SheetsGateway
WriteBackService --> TeacherBlankCellRepository
WriteBackService --> FoundationRepositories : current winners
GoogleSheetsGateway ..|> SheetsGateway
FakeSheetsGateway ..|> SheetsGateway

ActivityRecordService --> TeacherResultProjection : rounds()
ActivityRecordService --> CsvWriter

' Layout only: stack the packages in rows (Auth + rounds / Guided Notes + export / persistence + existing)
PasswordHash -[hidden]down- GuidedNotesImportService
LoginRateLimiter -[hidden]down- WriteBackService
TargetCatalog -[hidden]down- ActivityRecordService
SheetUrl -[hidden]down- TeacherLoginSessionRepository
CellComposer -[hidden]down- SessionLifecycleService
@enduml
