# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders only.

# ---------- Shared server ----------
NODE_ENV=development
PORT=3000
SQLITE_PATH=./data/quiz-system.sqlite
ACTIVITY_CODE_LOOKUP_MAX_REQUESTS=30
ACTIVITY_CODE_LOOKUP_WINDOW_MS=60000

# ---------- Student Feature ----------
STUDENT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# At least 32 random bytes.
STUDENT_CSRF_SECRET=replace-with-at-least-32-random-bytes-0000

# ---------- Teacher Feature ----------
# Generate with: npm run teacher:hash-password  (prompts for the password, prints only the hash)
TEACHER_PASSWORD_HASH=scrypt$32768$8$1$replace-with-salt$replace-with-hash
# At least 32 random bytes; different from STUDENT_CSRF_SECRET.
TEACHER_SESSION_SECRET=replace-with-at-least-32-random-bytes-1111
TEACHER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional. Absolute path to the Google service-account JSON key.
# The file MUST be outside this repository. Leave empty to disable Google Sheets import and write-back.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
